<Window x:Class="AiOptimize.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件更新"
        Height="340" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding NewVersionText}" FontSize="17" FontWeight="Bold"/>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <!-- 版本说明 -->
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource SubTextBrush}"/>
            </ScrollViewer>

            <!-- 状态文字（下载中 / 失败 / 已完成） -->
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource SubTextBrush}" Margin="0,10,0,0"/>

            <!-- 下载进度 -->
            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                         Style="{StaticResource SlimProgressBar}" Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="以后再说" Style="{StaticResource LinkButton}" Click="OnLaterClick"
                    Visibility="{Binding IsDownloading, Converter={StaticResource InvBoolToVis}}"/>
            <Button Content="下载更新" Style="{StaticResource AccentButton}" Click="OnDownloadClick"
                    Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}"/>
            <Button Content="取消下载" Style="{StaticResource LinkButton}" Click="OnCancelClick"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
            <Button Content="立即安装" Style="{StaticResource AccentButton}" Click="OnInstallClick"
                    Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Grid>
</Window>
