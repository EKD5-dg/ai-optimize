<Window x:Class="AiOptimize.Views.DiskCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="磁盘检查"
        Height="260" Width="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="系统盘健康检查" FontSize="17" FontWeight="Bold"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <ProgressBar Height="8" IsIndeterminate="True" Maximum="100"
                         Style="{StaticResource SlimProgressBar}" Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}"
                       TextWrapping="Wrap" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding ResultText}" FontSize="14" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#EF5350"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RepairScheduled}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Button Grid.Row="2" Content="安排修复（下次开机自动进行）" Height="40"
                Style="{StaticResource AccentButton}" Command="{Binding ScheduleRepairCommand}"
                Visibility="{Binding ShowRepairButton, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>
