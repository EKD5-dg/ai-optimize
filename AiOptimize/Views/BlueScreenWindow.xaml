<Window x:Class="AiOptimize.Views.BlueScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="蓝屏分析"
        Height="560" Width="720" MinHeight="400" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="蓝屏记录分析" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Text="{Binding EmptyText}" FontSize="15"
                   Foreground="{StaticResource SuccessBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,5">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="Bold" FontSize="14"
                                               Text="{Binding Time, StringFormat=yyyy/MM/dd HH:mm:ss}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StopCodeText}"
                                               Foreground="#EF5350" FontWeight="Bold" FontSize="14"/>
                                </Grid>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Cause}" Foreground="{StaticResource SubTextBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,4,0,0"><Run
                                        Text="建议：" Foreground="{StaticResource SuccessBrush}"/><Run
                                        Text="{Binding Advice, Mode=OneWay}"/></TextBlock>
                                <ItemsControl ItemsSource="{Binding Actions}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Command="{Binding RunCommand}"
                                                    Style="{StaticResource AccentButton}" Height="30" MinWidth="110"
                                                    FontSize="12" FontWeight="Normal" Margin="0,0,8,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding DumpPath}" Foreground="{StaticResource SubTextBrush}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DumpPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
