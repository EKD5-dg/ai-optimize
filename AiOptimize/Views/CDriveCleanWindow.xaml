<Window x:Class="AiOptimize.Views.CDriveCleanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="C盘清理"
        Height="660" Width="780" MinHeight="480" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="C 盘一键清理" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- C 盘空间总览 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <TextBlock Text="C 盘空间使用情况" Foreground="{StaticResource SubTextBrush}"/>
                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource SubTextBrush}" FontSize="11">
                        <Run Text="共 "/><Run Text="{Binding DriveTotalText, Mode=OneWay}"/><Run Text=" ｜ 已用 "/><Run
                            Text="{Binding DriveUsedText, Mode=OneWay}"/><Run Text=" ｜ 剩余 "/><Run
                            Text="{Binding DriveFreeText, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}"/>
                    </TextBlock>
                </Grid>
                <ProgressBar Height="12" Margin="0,10,0,0" Maximum="100"
                             Value="{Binding DriveUsage, Mode=OneWay}"
                             Style="{StaticResource SlimProgressBar}"
                             Foreground="{Binding DriveUsage, Converter={StaticResource UsageToBrush}}"/>
            </StackPanel>
        </Border>

        <!-- 状态区 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <ProgressBar Height="8" IsIndeterminate="True" Maximum="100"
                         Style="{StaticResource SlimProgressBar}" Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- 分类列表 -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,4" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"
                                          IsEnabled="{Binding DataContext.IsNotBusy,
                                              RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource SubTextBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,2,8,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                           Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部操作区 -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding ResultText}" Foreground="{StaticResource SuccessBrush}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,0,0,8"/>
            <Button Content="开始清理" Height="46" FontSize="16"
                    Style="{StaticResource AccentButton}" Command="{Binding CleanCommand}"/>
        </StackPanel>
    </Grid>
</Window>
